{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 1
  },
  "include": [".eleventy.ts", "samples/*.11ty*.ts", "src", "test"],
  "exclude": ["node_modules", "dist"]
}